<UserControl x:Class="Workflow.Views.TaskTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:Workflow.Views"
             xmlns:vm="clr-namespace:Workflow.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:TaskTabViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- One message in the status line: cut off with an ellipsis and shown in full as its
             tooltip, and collapsed while empty so it leaves no gap before its neighbour. -->
        <Style x:Key="StatusMessageStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- An empty TextBlock still measures one line tall, which left a blank line under the
             Workflow-Verzeichnis row. Its Visibility is bound locally (requirement 1.3), which a
             trigger cannot override, so while it has no text it shrinks to nothing instead. -->
        <Style x:Key="WorkflowDirectoryMessageStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Height" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Height" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- The form takes the height its content needs and the terminal everything below it, so no
         empty band opens between the two at any window size. The code-behind caps the form at
         half the tab: beyond that its fields scroll and the terminal keeps at least 50 %. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="FormArea" Grid.Row="0">

            <!-- Pinned above the terminal and outside the scroller, so Start, the phase state and
                 Task abschliessen stay in view when the fields have to scroll. The right margin
                 matches the scroller's padding, which keeps both right edges in line. -->
            <Border DockPanel.Dock="Bottom"
                    Margin="0,16,12,0"
                    Padding="0,12,0,0"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Visibility="{Binding IsTaskFinished, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Command="{Binding StartWorkflowCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" Text="{Binding StartButtonLabel}" />
                        </StackPanel>
                    </Button>

                    <!-- Takes the Start button's place once Implementation has written its done file: there
                         is nothing left to continue, so the one action left is to close the task. -->
                    <Button DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Visibility="{Binding IsTaskFinished, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding CloseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" Text="Task abschliessen" />
                        </StackPanel>
                    </Button>

                    <!-- WF_QUEUE: right of Start. Picking another open task starts this workflow by itself once that
                         task is finished (Implementierung green); the clear button empties the queue. Locked while this
                         tab runs, hidden with Start once this task is finished. -->
                    <ComboBox DockPanel.Dock="Left"
                              Width="240"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              materialDesign:HintAssist.Hint="Queue"
                              materialDesign:TextFieldAssist.HasClearButton="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              FontSize="14"
                              IsEditable="False"
                              DisplayMemberPath="Header"
                              ItemsSource="{Binding QueueCandidates}"
                              SelectedItem="{Binding QueuedAfter, Mode=TwoWay}"
                              IsEnabled="{Binding IsQueueEditable}"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="Startet den Workflow dieses Tasks automatisch, sobald der gewählte Task fertig ist (Implementierung grün). Zur Auswahl stehen die anderen geöffneten Tasks, die noch nicht fertig sind."
                              Visibility="{Binding IsTaskFinished, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                    <!-- The manual override steps aside once the task is finished, so the bar never
                         shows 'Task abschliessen' twice. -->
                    <Button DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="Task abschliessen"
                            Visibility="{Binding IsTaskFinished, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Command="{Binding CompleteTaskCommand}" />

                    <!-- Workflow_LoadFix spec 8.5: declared after 'Task abschliessen' with the same dock
                         side, so it sits directly to its left. Skips Vereinfachen, Review and Review
                         umsetzen - a running one is cancelled - and starts the implementation phase,
                         with subtasks when the checkbox says so. Disabled until the specification
                         phase is done. -->
                    <Button DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="Implementierung beginnen"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Vereinfachen, Review und Review umsetzen überspringen und sofort mit der Implementierung beginnen. Eine laufende Phase wird abgebrochen. Mit Subtasks, wenn 'Subtasks' ausgewählt ist."
                            Visibility="{Binding IsTaskFinished, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Command="{Binding StartImplementationCommand}" />

                    <!-- Requirements 1.1 and 3.1: the checkbox and the subtask indicator sit beside
                         the Implementierung indicator and wrap with it on a narrow window, so the
                         phase indicators and the subtask controls share one outer panel. -->
                    <WrapPanel Margin="24,0,16,0" VerticalAlignment="Center" Orientation="Horizontal">

                        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Phases}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:PhaseIndicatorView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Gate items the finished implementation left for a human (done file and
                             every completed subtask's status.json). Directly after the phases, so it
                             sits beside Implementierung, the last of them; shown only while there is
                             something to do. Opening the overview re-reads the files. The toggle is
                             not hit-testable while the popup is open, so the click that closes a
                             StaysOpen=False popup cannot reopen it at once. -->
                        <Grid Margin="0,0,24,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding HasOpenGateItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ToggleButton x:Name="OpenGateItemsToggle"
                                          Width="32"
                                          Height="32"
                                          Command="{Binding RefreshOpenGateItemsOnOpenCommand}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignFlatToggleButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen, ElementName=OpenGateItemsPopup}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <ToggleButton.ToolTip>
                                    <TextBlock Text="{Binding OpenGateItemCount, StringFormat='{}{0} offene Punkte - klicken für die Übersicht'}" />
                                </ToggleButton.ToolTip>
                                <materialDesign:PackIcon Width="20" Height="20" Foreground="#F57C00">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="ClipboardAlertOutline" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOpenGateReadErrors}" Value="True">
                                                    <Setter Property="Kind" Value="FileAlertOutline" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </ToggleButton>

                            <Popup x:Name="OpenGateItemsPopup"
                                   IsOpen="{Binding IsChecked, ElementName=OpenGateItemsToggle, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=OpenGateItemsToggle}"
                                   Placement="Top"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Width="560"
                                        Padding="12"
                                        Background="{DynamicResource MaterialDesignPaper}"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    ToolTip="Alle offenen Punkte in die Zwischenablage kopieren"
                                                    Click="CopyOpenGateItems_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon x:Name="OpenGateItemsCopyIcon" Kind="ContentCopy" VerticalAlignment="Center" />
                                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Alles kopieren" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesignBody}"
                                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                       Text="{Binding OpenGateItemCount, StringFormat='Offene Punkte ({0})'}" />
                                        </DockPanel>
                                        <TextBox x:Name="OpenGateItemsBox"
                                                 MaxHeight="320"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding OpenGateItemsText, Mode=OneWay}" />
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <CheckBox Margin="0,0,24,0"
                                  VerticalAlignment="Center"
                                  Content="Subtasks"
                                  IsChecked="{Binding SubtasksEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding IsSubtaskConfigurationEditable}"
                                  ToolTip="Wenn die Aufgabe das Kontextfenster eines Agents übersteigt, aktiviere Subtasks" />

                        <!-- Workflow_LOAD_AND_PAUSE spec 6.5: beside the Subtasks checkbox. Pause lets
                             the running phase (or, in Implementation, the running subtask) finish and holds
                             the next one; Play, shown only while paused, lifts the hold. Neither
                             touches the running session, so neither is tied to IsRunning or to the
                             Implementation lock. -->
                        <StackPanel Margin="0,0,24,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Width="32"
                                    Height="32"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Pausieren: Die laufende Phase bzw. der laufende Subtask läuft zu Ende, der nächste Schritt startet erst nach Fortsetzen"
                                    Command="{Binding PauseCommand}">
                                <materialDesign:PackIcon Kind="Pause" Width="20" Height="20" />
                            </Button>

                            <Button Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Fortsetzen: Der nächste Schritt startet wieder automatisch"
                                    Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Command="{Binding UnpauseCommand}">
                                <materialDesign:PackIcon Kind="Play" Width="20" Height="20" />
                            </Button>
                        </StackPanel>

                        <!-- The wrapper keeps the tab's DataContext for the Visibility binding while
                             the inner view receives the indicator view model; one element cannot do
                             both. The indicator's contents belong to SubtaskIndicatorViewModel.
                             The 'Desktop-Job jetzt starten' button sits beside the indicator: desktop jobs
                             exist only in subtask mode, and it is enabled only while a run waits for one. -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SubtasksEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <views:SubtaskIndicatorView DataContext="{Binding SubtaskIndicator}" />
                            <Button Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="Desktop-Job jetzt starten"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Startet den wartenden Desktop-Job sofort, ohne die Leerlaufzeit abzuwarten. Danach Maus und Tastatur nicht berühren: jede Maus- oder Tastatureingabe und jede Sperre des Arbeitsplatzes bricht den Job ab. Nur aktiv, solange ein Desktop-Job auf Leerlauf wartet und nicht pausiert ist."
                                    Command="{Binding StartDesktopJobNowCommand}" />
                        </StackPanel>

                    </WrapPanel>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <!-- Top margin: an outlined box draws its floating hint above its border, and the
                     scroller would otherwise clip the hint of the first row. -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             Grid.Column="0"
                             materialDesign:HintAssist.Hint="Task"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="14"
                             IsReadOnly="{Binding IsNameLocked}"
                             Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" />

                    <DockPanel Grid.Row="0" Grid.Column="2" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Verzeichnis auswählen"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding BrowseDirectoryCommand}">
                            <materialDesign:PackIcon Kind="FolderOpen" />
                        </Button>

                        <ComboBox materialDesign:HintAssist.Hint="Arbeitsverzeichnis"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  FontSize="14"
                                  IsEditable="False"
                                  ItemsSource="{Binding RecentDirectories}"
                                  SelectedItem="{Binding WorkingDirectory, Mode=TwoWay}" />
                    </DockPanel>

                    <!-- Requirement 1.2: structurally identical to the Arbeitsverzeichnis row and in
                         the same column directly beneath it, so the two read as one family, and
                         shown only while subtask mode is selected. Both controls sit in this
                         DockPanel, so hiding it hides the whole row. -->
                    <DockPanel Grid.Row="1"
                               Grid.Column="2"
                               Margin="0,12,0,0"
                               LastChildFill="True"
                               Visibility="{Binding SubtasksEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Workflow-Verzeichnis auswählen"
                                Style="{StaticResource MaterialDesignIconButton}"
                                IsEnabled="{Binding IsSubtaskConfigurationEditable}"
                                Command="{Binding BrowseWorkflowDirectoryCommand}">
                            <materialDesign:PackIcon Kind="FolderOpen" />
                        </Button>

                        <ComboBox materialDesign:HintAssist.Hint="Workflow-Verzeichnis"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  FontSize="14"
                                  IsEditable="False"
                                  IsEnabled="{Binding IsSubtaskConfigurationEditable}"
                                  ItemsSource="{Binding RecentWorkflowDirectories}"
                                  SelectedItem="{Binding WorkflowDirectory, Mode=TwoWay}" />
                    </DockPanel>

                    <!-- Requirement 1.3. Its own surface, not the status line below: that one is
                         rewritten on every keystroke by the folder synchronisation. -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Style="{StaticResource WorkflowDirectoryMessageStyle}"
                               Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding SubtasksEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Text="{Binding WorkflowDirectoryMessage}" />

                    <!-- A fixed height of one line, whatever it shows: the launcher status arrives
                         while a session is starting and the folder info stays up for the whole
                         run, and a line that grew or shrank would resize the terminal - and with
                         it the pty - just as the agent draws its screen. -->
                    <DockPanel Grid.Row="3"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Height="20"
                               Margin="4,4,0,0"
                               LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource StatusMessageStyle}"
                                   Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                   Text="{Binding ValidationMessage}" />

                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource StatusMessageStyle}"
                                   Opacity="0.75"
                                   Text="{Binding InfoMessage}" />

                        <TextBlock Style="{StaticResource StatusMessageStyle}"
                                   FontWeight="SemiBold"
                                   Text="{Binding LauncherStatusMessage}" />
                    </DockPanel>

                    <!-- No Height: MinLines/MaxLines only apply without one, so the box grows by one
                         line per line of text and scrolls from the eleventh line on. -->
                    <DockPanel Grid.Row="4"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Margin="0,8,0,0"
                               LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Margin="8,4,0,0"
                                VerticalAlignment="Top"
                                ToolTip="Taskbeschreibung kopieren"
                                Click="CopyTaskDescription_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=TaskDescriptionBox}" Value="0">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon x:Name="CopyIcon" Kind="ContentCopy" />
                        </Button>

                        <TextBox x:Name="TaskDescriptionBox"
                                 materialDesign:HintAssist.Hint="Taskbeschreibung"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinLines="1"
                                 MaxLines="10"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="14"
                                 CaretBrush="{DynamicResource MaterialDesignBody}"
                                 Text="{Binding TaskDescription, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <views:TerminalView Grid.Row="1" Margin="0,12,0,0" DataContext="{Binding Terminal}" />
    </Grid>
</UserControl>
