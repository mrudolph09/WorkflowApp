<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Local copy: this dictionary is merged before App.xaml's own converters are defined. -->
    <BooleanToVisibilityConverter x:Key="TabContentVisibilityConverter" />

    <!-- Tabs are drawn from scratch rather than derived from MahApps.Styles.TabItem. The MahApps
         style renders a header as bare accent-coloured text with no surface, which gave the tab
         strip no visual affordance at all - a user could not tell the headers were tabs, nor that
         the '+' beside them opened another one. The folder-tab shape below (raised surface, top
         corner radius, accent bar, shared baseline) is what makes the control self-describing. -->

    <Style x:Key="WorkflowTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root"
                            MinHeight="40"
                            CornerRadius="8,8,0,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1,1,1,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Accent bar marks the selected tab even for colour-blind users,
                                 because it is a position cue and not only a hue cue. -->
                            <Border x:Name="Accent"
                                    Grid.ColumnSpan="2"
                                    Height="3"
                                    VerticalAlignment="Top"
                                    CornerRadius="8,8,0,0"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Header"
                                              Margin="16,10,8,10"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />

                            <Button x:Name="CloseButton"
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    ToolTip="Task schliessen"
                                    Command="{Binding DataContext.CloseTabCommand,
                                                      RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseChrome"
                                                Background="Transparent"
                                                CornerRadius="12">
                                            <materialDesign:PackIcon Kind="Close"
                                                                     Width="14"
                                                                     Height="14"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseChrome"
                                                        Property="Background"
                                                        Value="{DynamicResource MaterialDesignDivider}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Panel.ZIndex" Value="2" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The chip both tab-strip buttons share. Drawn as an empty tab rather than as a floating
         action button: sharing the tabs' shape and baseline is what tells the user that pressing it
         produces a tab. Declared above WorkflowTabControlStyle, whose template references it. -->
    <Style x:Key="WorkflowTabStripButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <!-- FontSize and FontWeight were inherited from the implicit MaterialDesign Button style
             before this style existed; keep the "Neuer Task" chip looking the same. -->
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip"
                            CornerRadius="8,8,0,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1,1,1,0"
                            Padding="12,8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip"
                                    Property="Background"
                                    Value="{DynamicResource MaterialDesignDivider}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkflowTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource WorkflowTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel LastChildFill="True">

                        <Grid DockPanel.Dock="Top" Margin="8,0,8,0">
                            <!-- Two columns (Workflow_LOAD_AND_PAUSE spec 5.2): the headers and
                                 'Neuer Task' on the left, 'Task laden' in the top-right corner just
                                 under the title bar's version number. Headers that no longer fit are
                                 clipped at the column edge instead of sliding under the chip. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- The baseline runs the full width behind the headers. It is what
                                 turns a row of separate buttons into one tab strip. -->
                            <Border Grid.ColumnSpan="2"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource MaterialDesignDivider}" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          VerticalAlignment="Bottom"
                                          Panel.ZIndex="1"
                                          KeyboardNavigation.TabIndex="1" />

                                <Button x:Name="AddTabButton"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource WorkflowTabStripButtonStyle}"
                                        ToolTip="Neuen Task in einem weiteren Tab öffnen"
                                        Command="{Binding AddTaskTabCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus"
                                                                 Width="18"
                                                                 Height="18"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="Neuer Task" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Button x:Name="LoadTaskButton"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource WorkflowTabStripButtonStyle}"
                                    ToolTip="Vorhandenen Task-Ordner als Tab öffnen"
                                    Command="{Binding LoadTaskCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpen"
                                                             Width="18"
                                                             Height="18"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Task laden" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- NOT a single content host. A TabControl's PART_SelectedContentHost
                             reuses one TaskTabView (and therefore ONE WebView2) for every tab:
                             switching tabs only swaps the DataContext, Loaded never fires for the
                             newly shown tab, and its TerminalViewModel is never attached - the
                             terminal area stays blank. Instead every tab keeps its own live view
                             stacked in a Grid and only the selected one is visible, so each tab
                             owns its WebView2 and PTY output for its whole lifetime (spec 12.4:
                             one WebView2 per tab, tabs keep running while not shown). -->
                        <ItemsControl x:Name="PART_SelectedContentHost"
                                      Margin="8"
                                      Focusable="False"
                                      ItemsSource="{TemplateBinding ItemsSource}"
                                      ItemTemplate="{TemplateBinding ContentTemplate}"
                                      ItemTemplateSelector="{TemplateBinding ContentTemplateSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility"
                                            Value="{Binding IsSelected, Converter={StaticResource TabContentVisibilityConverter}}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
