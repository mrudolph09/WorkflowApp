        </GeometryDrawing>
        <GeometryDrawing Geometry="M 92 65 C 78 135, 88 205, 78 265 C 69 315, 57 330, 60 350 C 57 370, 69 385, 78 435 C 88 495, 78 565, 92 635">
            <GeometryDrawing.Pen>
                <Pen Brush="#A6FBE083" Thickness="9" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- Right frame -->
        <GeometryDrawing Brush="{StaticResource TerminalFrameGoldVerticalBrush}"
                         Geometry="F1 M 925 25 C 945 90, 936 160, 945 230 C 952 290, 971 330, 962 350 C 971 370, 952 410, 945 470 C 936 540, 945 610, 925 675 L 840 646 C 860 575, 855 520, 862 470 C 868 420, 885 380, 880 350 C 885 320, 868 280, 862 230 C 855 180, 860 125, 840 54 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#6A3309" Thickness="7" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 908 65 C 922 135, 912 205, 922 265 C 931 315, 943 330, 940 350 C 943 370, 931 385, 922 435 C 912 495, 922 565, 908 635">
            <GeometryDrawing.Pen>
                <Pen Brush="#A6FBE083" Thickness="9" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- Inner rectangular border; the centre stays transparent -->
        <GeometryDrawing>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="145,105,710,490" RadiusX="2" RadiusY="2" />
            </GeometryDrawing.Geometry>
            <GeometryDrawing.Pen>
                <Pen Brush="#613007" Thickness="12" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="155,115,690,470" RadiusX="2" RadiusY="2" />
            </GeometryDrawing.Geometry>
            <GeometryDrawing.Pen>
                <Pen Brush="{StaticResource TerminalFrameInnerGoldBrush}" Thickness="15" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="169,129,662,442" />
            </GeometryDrawing.Geometry>
            <GeometryDrawing.Pen>
                <Pen Brush="#FFE99B" Thickness="4" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="176,136,648,428" />
            </GeometryDrawing.Geometry>
            <GeometryDrawing.Pen>
                <Pen Brush="#70400F" Thickness="4" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- Corner ornaments: SVG translate(x y) scale(sx sy) is the matrix "sx,0,0,sy,x,y" -->
        <DrawingGroup Transform="1,0,0,1,100,73">
            <DrawingGroup.Children>
                <DrawingCollection>
                    <StaticResource ResourceKey="TerminalFrameCornerOrnament" />
                </DrawingCollection>
            </DrawingGroup.Children>
        </DrawingGroup>
        <DrawingGroup Transform="-1,0,0,1,900,73">
            <DrawingGroup.Children>
                <DrawingCollection>
                    <StaticResource ResourceKey="TerminalFrameCornerOrnament" />
                </DrawingCollection>
            </DrawingGroup.Children>
        </DrawingGroup>
        <DrawingGroup Transform="1,0,0,-1,100,627">
            <DrawingGroup.Children>
                <DrawingCollection>
                    <StaticResource ResourceKey="TerminalFrameCornerOrnament" />
                </DrawingCollection>
            </DrawingGroup.Children>
        </DrawingGroup>
        <DrawingGroup Transform="-1,0,0,-1,900,627">
            <DrawingGroup.Children>
                <DrawingCollection>
                    <StaticResource ResourceKey="TerminalFrameCornerOrnament" />
                </DrawingCollection>
            </DrawingGroup.Children>
        </DrawingGroup>

        <!-- Top and bottom centre ornaments -->
        <DrawingGroup Transform="1,0,0,1,500,52">
            <DrawingGroup.Children>
                <DrawingCollection>
                    <StaticResource ResourceKey="TerminalFrameCenterOrnament" />
                </DrawingCollection>
            </DrawingGroup.Children>
        </DrawingGroup>
        <DrawingGroup Transform="1,0,0,-1,500,648">
            <DrawingGroup.Children>
                <DrawingCollection>
                    <StaticResource ResourceKey="TerminalFrameCenterOrnament" />
                </DrawingCollection>
            </DrawingGroup.Children>
        </DrawingGroup>

        <!-- Side ornaments -->
        <DrawingGroup Transform="1,0,0,1,82,350">
            <DrawingGroup.Children>
                <DrawingCollection>
                    <StaticResource ResourceKey="TerminalFrameSideOrnament" />
                </DrawingCollection>
            </DrawingGroup.Children>
        </DrawingGroup>
        <DrawingGroup Transform="-1,0,0,1,918,350">
            <DrawingGroup.Children>
                <DrawingCollection>
                    <StaticResource ResourceKey="TerminalFrameSideOrnament" />
                </DrawingCollection>
            </DrawingGroup.Children>
        </DrawingGroup>

        <!-- Small decorative leaves -->
        <GeometryDrawing Brush="#A65D15" Geometry="F1 M 183 68 C 208 49 233 50 250 65 C 223 64 206 75 183 68 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#683209" Thickness="2" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#A65D15" Geometry="F1 M 817 68 C 792 49 767 50 750 65 C 777 64 794 75 817 68 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#683209" Thickness="2" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#A65D15" Geometry="F1 M 183 632 C 208 651 233 650 250 635 C 223 636 206 625 183 632 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#683209" Thickness="2" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#A65D15" Geometry="F1 M 817 632 C 792 651 767 650 750 635 C 777 636 794 625 817 632 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#683209" Thickness="2" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- Nine-slice-style frame. The drawing is cut along the lines below and every piece is drawn
         at a fixed scale of 1/4, so a 176 x 136 SVG corner is always 44 x 34 on screen and never
         distorts; only the plain runs of moulding between the ornaments stretch, and only along
         their own length. Cuts in x for the top and bottom bands: 0 | 260 | 380 | 620 | 740 | 1000
         (the corners with their leaves, and the centre ornament, stay fixed). Cuts in y for the
         side bands: 136 | 220 | 480 | 564 (the side ornament stays fixed). Every size below is the
         SVG length times 1/4. The opening, 176..824 x 136..564, holds the content, which is
         arranged beside the frame and never beneath it: the terminal is a WebView2, an HwndHost
         whose window would cover any WPF element drawn over it.

         SnapsToDevicePixels and UseLayoutRounding are load-bearing, not cosmetic, and a test
         removes each one and fails (TerminalFrameStyleTests). Nothing above this frame rounds
         layout, so the frame can land between device pixels: without SnapsToDevicePixels the edges
         of adjacent pieces are then anti-aliased against each other and a faint line of the
         background shows through at every cut. It is a setter on the ContentControl rather than an
         attribute of the template's root so that the content inherits it too and meets the frame
         without a seam. UseLayoutRounding keeps the pieces, and with them the opening, on whole
         device pixels at fractional display scaling. -->
    <Style x:Key="TerminalFrameStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid UseLayoutRounding="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <!-- Top band -->
                        <Grid Grid.Row="0" Grid.ColumnSpan="3" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="0,0,260,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="1">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="260,0,120,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="2">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="380,0,240,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="3">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="620,0,120,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="4">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="740,0,260,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <!-- Bottom band -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="3" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="0,564,260,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="1">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="260,564,120,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="2">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="380,564,240,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="3">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="620,564,120,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Column="4">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="740,564,260,136" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <!-- Left band -->
                        <Grid Grid.Row="1" Grid.Column="0" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="65" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="0,136,176,84" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Row="1">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="0,220,176,260" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Row="2">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="0,480,176,84" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <!-- Right band -->
                        <Grid Grid.Row="1" Grid.Column="2" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="65" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="824,136,176,84" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Row="1">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="824,220,176,260" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Grid.Row="2">
                                <Rectangle.Fill>
                                    <DrawingBrush Drawing="{StaticResource TerminalFrameDrawing}" Viewbox="824,480,176,84" ViewboxUnits="Absolute" Stretch="Fill" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <ContentPresenter Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
