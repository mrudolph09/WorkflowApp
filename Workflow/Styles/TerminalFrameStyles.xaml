                <Pen Brush="#5D2906" Thickness="5" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource TerminalFrameOrnamentGoldBrush}"
                         Geometry="F1 M -43 -6 C -65 -22 -62 -48 -38 -56 C -17 -63 -12 -39 -21 -26 C -7 -39 10 -45 22 -33 C 35 -20 19 -5 5 1 C 28 3 40 22 25 37 C 11 51 -6 35 -11 20 C -18 43 -42 48 -54 29 C -65 12 -54 0 -43 -6 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#6C350A" Thickness="4" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#C27A1D">
            <GeometryDrawing.Geometry>
                <EllipseGeometry Center="-8,-4" RadiusX="18" RadiusY="25" />
            </GeometryDrawing.Geometry>
            <GeometryDrawing.Pen>
                <Pen Brush="#603006" Thickness="4" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#E8B649"
                         Geometry="F1 M -19 -8 C -9 -25 9 -25 15 -11 C 19 3 7 17 -7 15 C -23 12 -27 2 -19 -8">
            <GeometryDrawing.Pen>
                <Pen Brush="#6C350A" Thickness="3" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="TerminalFrameCenterOrnament">
        <GeometryDrawing Brush="{StaticResource TerminalFrameOrnamentGoldBrush}"
                         Geometry="F1 M -82 10 C -65 -4 -57 -25 -35 -21 C -24 -38 -7 -39 0 -20 C 7 -39 24 -38 35 -21 C 57 -25 65 -4 82 10 C 64 20 49 18 37 14 C 27 35 10 35 0 20 C -10 35 -27 35 -37 14 C -49 18 -64 20 -82 10 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#673009" Thickness="5" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#D99A2F">
            <GeometryDrawing.Geometry>
                <EllipseGeometry Center="0,0" RadiusX="23" RadiusY="18" />
            </GeometryDrawing.Geometry>
            <GeometryDrawing.Pen>
                <Pen Brush="#703A0B" Thickness="4" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#F1C354"
                         Geometry="F1 M -13 0 C -4 -15 7 -15 15 -4 C 19 6 8 15 -2 13 C -14 12 -20 7 -13 0 Z" />
    </DrawingGroup>

    <DrawingGroup x:Key="TerminalFrameSideOrnament">
        <GeometryDrawing Brush="{StaticResource TerminalFrameOrnamentGoldBrush}"
                         Geometry="F1 M 0 -70 C 27 -61 39 -43 28 -23 C 49 -14 48 11 30 23 C 40 46 22 65 0 70 C -22 65 -40 46 -30 23 C -48 11 -49 -14 -28 -23 C -39 -43 -27 -61 0 -70 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#632E07" Thickness="5" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#D9972A"
                         Geometry="F1 M 0 -43 C 23 -31 25 -12 9 -2 C 24 9 18 29 0 40 C -18 29 -24 9 -9 -2 C -25 -12 -23 -31 0 -43">
            <GeometryDrawing.Pen>
                <Pen Brush="#72380B" Thickness="4" MiterLimit="4" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
    </DrawingGroup>

