        </GeometryDrawing>

        <!-- Left frame -->
        <GeometryDrawing Brush="{StaticResource TerminalFrameGoldVerticalBrush}"
                         Geometry="F1 M 75 25 C 55 90, 64 160, 55 230 C 48 290, 29 330, 38 350 C 29 370, 48 410, 55 470 C 64 540, 55 610, 75 675 L 160 646 C 140 575, 145 520, 138 470 C 132 420, 115 380, 120 350 C 115 320, 132 280, 138 230 C 145 180, 140 125, 160 54 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#6A3309" Thickness="7" MiterLimit="4" />
