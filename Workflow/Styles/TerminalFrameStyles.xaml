        <GeometryDrawing Geometry="M 100 87 C 220 75, 325 83, 405 82 C 450 82, 470 70, 500 69 C 530 70, 550 82, 595 82 C 675 83, 780 75, 900 87">
            <GeometryDrawing.Pen>
                <Pen Brush="#78400F" Thickness="8" MiterLimit="4" />
