             Viewbox below is written in plain SVG coordinates. -->
        <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,1000,700" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Top frame -->
        <GeometryDrawing Brush="{StaticResource TerminalFrameGoldHorizontalBrush}"
                         Geometry="F1 M 75 25 C 190 5, 300 22, 395 24 C 430 24, 455 9, 500 4 C 545 9, 570 24, 605 24 C 700 22, 810 5, 925 25 L 905 118 C 790 104, 680 111, 600 108 C 555 106, 535 96, 500 95 C 465 96, 445 106, 400 108 C 320 111, 210 104, 95 118 Z">
