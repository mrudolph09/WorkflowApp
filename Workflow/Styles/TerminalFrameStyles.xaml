<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The gold frame drawn around every terminal. Everything up to TerminalFrameStyle is a
         one-to-one translation of Assets/terminal-frame.svg (viewBox 0 0 1000 700): same element
         order, same coordinates, same colours. Two SVG defaults WPF does not share are restated on
         every element: fills use F1 (nonzero - WPF path markup defaults to even-odd) and every pen
         has MiterLimit="4" (WPF defaults to 10, which grows spikes on the ornaments' sharp cusps).
         SVG opacity on a single stroke is folded into the stroke colour's alpha. -->

    <LinearGradientBrush x:Key="TerminalFrameGoldHorizontalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#6F390D" />
        <GradientStop Offset="0.08" Color="#B66B19" />
        <GradientStop Offset="0.20" Color="#F7D36B" />
        <GradientStop Offset="0.34" Color="#A85D13" />
        <GradientStop Offset="0.53" Color="#E6AF42" />
        <GradientStop Offset="0.70" Color="#7F420D" />
        <GradientStop Offset="0.86" Color="#F0C65B" />
        <GradientStop Offset="1" Color="#6E350B" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TerminalFrameGoldVerticalBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#70380C" />
        <GradientStop Offset="0.12" Color="#D79731" />
        <GradientStop Offset="0.29" Color="#F8D773" />
        <GradientStop Offset="0.45" Color="#A65B13" />
        <GradientStop Offset="0.65" Color="#E7AE3F" />
        <GradientStop Offset="0.83" Color="#8A470E" />
        <GradientStop Offset="1" Color="#E7B54C" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="TerminalFrameOrnamentGoldBrush">
        <GradientStop Offset="0" Color="#FFF0A5" />
        <GradientStop Offset="0.28" Color="#E4A83A" />
        <GradientStop Offset="0.62" Color="#9B5210" />
        <GradientStop Offset="1" Color="#542607" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TerminalFrameInnerGoldBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF1A4" />
        <GradientStop Offset="0.30" Color="#C98120" />
        <GradientStop Offset="0.60" Color="#7F400C" />
        <GradientStop Offset="1" Color="#EFC457" />
    </LinearGradientBrush>

    <!-- The SVG repeats each ornament verbatim under a different transform; here each one is
         drawn once and placed four or two times below. Each placement spells out
         DrawingGroup.Children and DrawingCollection: a bare StaticResource element as the content
         of a DrawingGroup is taken as the value of Children itself, not as one item in it, and the
         dictionary then fails to load. -->
